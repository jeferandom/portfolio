---
---
<div id="image-zoom-gallery" class="contents">
  <slot />
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/photoswipe.css';

  function initPhotoSwipe() {
    const gallery = document.getElementById('image-zoom-gallery');
    if (!gallery) return;

    const images = gallery.querySelectorAll('img');
    images.forEach((img) => {
      if (img.parentElement?.tagName === 'A') return;
      const wrapper = document.createElement('a');
      wrapper.href = img.src;
      wrapper.dataset.pswpWidth = String(img.naturalWidth || img.width);
      wrapper.dataset.pswpHeight = String(img.naturalHeight || img.height);
      wrapper.dataset.pswpSrc = img.src;
      wrapper.dataset.pswpImgSrc = img.src;
      img.parentNode?.insertBefore(wrapper, img);
      wrapper.appendChild(img);
    });

    const lightbox = new PhotoSwipeLightbox({
      gallery: '#image-zoom-gallery',
      children: 'a',
      pswpModule: () => import('photoswipe'),
    });

    lightbox.init();
  }

  document.addEventListener('astro:page-load', initPhotoSwipe);
  initPhotoSwipe();
</script>
