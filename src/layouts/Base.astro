---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={import.meta.env.BASE_URL + '/favicon.ico'} />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
        color: #1a1a1a;
        max-width: 640px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
      a { color: #2563eb; text-decoration: none; }
      a:hover { text-decoration: underline; }
      nav { margin-bottom: 2rem; }
      nav a { margin-right: 1rem; }
      footer { margin-top: 4rem; padding-top: 1rem; border-top: 1px solid #eee; color: #666; font-size: 0.875rem; }
    </style>
  </head>
  <body>
    <nav>
      <a href={import.meta.env.BASE_URL + '/'}>Inicio</a>
      <a href={import.meta.env.BASE_URL + '/projects'}>Proyectos</a>
    </nav>
    <slot />
    <footer>&copy; {new Date().getFullYear()}</footer>
  </body>
</html>
