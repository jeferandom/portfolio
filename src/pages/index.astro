---
import Base from '../layouts/Base.astro';
---
<Base title="Portfolio | Jhefferson Mancera Silva">
  <main>
    <section
      class="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3.5 dark:border-amber-800 dark:bg-amber-950/30"
    >
      <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">En construcción</h2>
      <p class="mt-1 text-xs text-zinc-600 dark:text-zinc-400">
        Esta sección estará lista el <strong class="text-zinc-900 dark:text-zinc-100"
          >24 de agosto de 2026 a las 8:00 a. m.</strong
        >
      </p>
      <div
        id="countdown-home"
        class="mt-3 flex flex-wrap gap-2 text-center"
        aria-live="polite"
      >
        <div
          class="min-w-12 flex-1 rounded-md border border-zinc-200 bg-white py-1.5 dark:border-zinc-700 dark:bg-zinc-800"
        >
          <span id="cdh-days" class="text-lg font-bold text-zinc-900 dark:text-zinc-100">--</span>
          <small class="block text-[0.625rem] uppercase text-zinc-500 dark:text-zinc-400">días</small>
        </div>
        <div
          class="min-w-12 flex-1 rounded-md border border-zinc-200 bg-white py-1.5 dark:border-zinc-700 dark:bg-zinc-800"
        >
          <span id="cdh-hours" class="text-lg font-bold text-zinc-900 dark:text-zinc-100">--</span>
          <small class="block text-[0.625rem] uppercase text-zinc-500 dark:text-zinc-400">horas</small>
        </div>
        <div
          class="min-w-12 flex-1 rounded-md border border-zinc-200 bg-white py-1.5 dark:border-zinc-700 dark:bg-zinc-800"
        >
          <span id="cdh-minutes" class="text-lg font-bold text-zinc-900 dark:text-zinc-100">--</span>
          <small class="block text-[0.625rem] uppercase text-zinc-500 dark:text-zinc-400">min</small>
        </div>
        <div
          class="min-w-12 flex-1 rounded-md border border-zinc-200 bg-white py-1.5 dark:border-zinc-700 dark:bg-zinc-800"
        >
          <span id="cdh-seconds" class="text-lg font-bold text-zinc-900 dark:text-zinc-100">--</span>
          <small class="block text-[0.625rem] uppercase text-zinc-500 dark:text-zinc-400">seg</small>
        </div>
      </div>
      <noscript>
        <p class="mt-2 text-xs">Lanzamiento: 24 de agosto de 2026, 8:00 a. m.</p>
      </noscript>
    </section>

    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Hola, soy Jhefferson Mancera Silva
    </h1>
    <p class="mt-2 text-[0.9375rem] text-zinc-700 dark:text-zinc-300">
      Full Stack Developer con 6 años de experiencia en JavaScript, especializado en React y
      Node.js. Experiencia en startups, equipos remotos y entrega continua.
    </p>

    <section class="mt-6">
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Tecnologías principales</h2>
      <p class="mt-1 text-[0.9375rem] text-zinc-700 dark:text-zinc-300">
        React · Next.js · Node.js · NestJS · TypeScript · MongoDB · Docker
      </p>
    </section>

    <section class="mt-6">
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Contacto</h2>
      <ul class="flex list-none flex-wrap gap-x-4 gap-y-2">
        <li><a href="https://github.com/jeferandom" class="text-blue-600 hover:underline dark:text-blue-400">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/jefjs/" class="text-blue-600 hover:underline dark:text-blue-400">LinkedIn</a></li>
        <li><a href="mailto:contactjefjs@gmail.com" class="text-blue-600 hover:underline dark:text-blue-400">Email</a></li>
      </ul>
    </section>

    <section class="mt-6">
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Proyectos destacados</h2>
      <p><a href={import.meta.env.BASE_URL + '/projects'} class="text-blue-600 hover:underline dark:text-blue-400">Ver todos los proyectos &rarr;</a></p>
    </section>
  </main>
</Base>

<script>
  const target = new Date('2026-08-24T08:00:00').getTime();

  function updateCountdownHome() {
    const container = document.getElementById('countdown-home');
    if (!container) return;

    const diff = target - Date.now();

    const days = Math.floor(diff / 86400000);
    const hours = Math.floor(diff / 3600000) % 24;
    const minutes = Math.floor(diff / 60000) % 60;
    const seconds = Math.floor(diff / 1000) % 60;

    document.getElementById('cdh-days')!.textContent = String(days);
    document.getElementById('cdh-hours')!.textContent = String(hours).padStart(2, '0');
    document.getElementById('cdh-minutes')!.textContent = String(minutes).padStart(2, '0');
    document.getElementById('cdh-seconds')!.textContent = String(seconds).padStart(2, '0');

    setTimeout(updateCountdownHome, 1000);
  }

  updateCountdownHome();
</script>
