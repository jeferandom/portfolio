---
import Base from '../layouts/Base.astro';
---
<Base title="Portfolio | Jhefferson Mancera Silva">
  <main>
    <h1>Hola, soy Jhefferson Mancera Silva</h1>
    <p>Full Stack Developer con 6 años de experiencia en JavaScript, especializado en React y Node.js. Experiencia en startups, equipos remotos y entrega continua.</p>

    <section style="margin-top: 2rem;">
      <h2>Tecnologías principales</h2>
      <p>React · Next.js · Node.js · NestJS · TypeScript · MongoDB · Docker</p>
    </section>

    <section style="margin-top: 2rem;">
      <h2>Contacto</h2>
      <ul>
        <li><a href="https://github.com/jeferandom">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/jefjs/">LinkedIn</a></li>
        <li><a href="mailto:contactjefjs@gmail.com">Email</a></li>
      </ul>
    </section>

    <section style="margin-top: 2rem;">
      <h2>Proyectos destacados</h2>
      <p><a href={import.meta.env.BASE_URL + '/projects'}>Ver todos los proyectos &rarr;</a></p>
    </section>
  </main>
</Base>
