---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Base title={project.data.title} description={project.data.description}>
  <article>
    <a
      href={import.meta.env.BASE_URL + '/projects'}
      class="text-blue-600 hover:underline dark:text-blue-400">&larr; Volver</a
    >
    <h1 class="mt-4 text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      {project.data.title}
    </h1>
    <p class="text-[0.9375rem] text-zinc-500 dark:text-zinc-400">
      {project.data.date.toLocaleDateString('es')}
    </p>
    {project.data.tags && (
      <div class="my-2 flex flex-wrap gap-1">
        {project.data.tags.map((tag) => (
          <span
            class="rounded bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300"
            >{tag}</span
          >
        ))}
      </div>
    )}
    <div class="my-4 flex flex-wrap gap-x-4 gap-y-2">
      {project.data.url && (
        <a
          href={project.data.url}
          target="_blank"
          class="text-blue-600 hover:underline dark:text-blue-400">Demo &rarr;</a
        >
      )}
      {project.data.repo && (
        <a
          href={project.data.repo}
          target="_blank"
          class="text-blue-600 hover:underline dark:text-blue-400">Código &rarr;</a
        >
      )}
    </div>
    <div
      class="prose prose-zinc mt-6 max-w-none dark:prose-invert prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:mx-auto prose-img:rounded-md"
    >
      <Content />
    </div>
  </article>
</Base>
